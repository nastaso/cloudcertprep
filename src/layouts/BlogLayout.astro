---
/**
 * BlogLayout.astro — wraps a single blog post.
 *
 * Emits BlogPosting JSON-LD anchored to the Person entity (@id) in the
 * BaseLayout graph, renders a breadcrumb trail, and delegates page chrome,
 * meta tags, and platform JSON-LD to BaseLayout. The post body is rendered
 * via the default <slot />.
 *
 * Canonical is self-referential (https://www.cloudcertprep.io/blog/<slug>)
 * unless frontmatter.canonical overrides it.
 *
 * Emits article-namespace Open Graph meta (published/modified time, author,
 * tags) into <head> via BaseLayout's named `head` slot. RSS autodiscovery is
 * emitted site-wide by BaseLayout (R4.17).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { SITE_URL } from '../lib/seo-data'
import { serializeJsonLd } from '../lib/jsonld'
import { buttonClass } from '../lib/buttonStyles'

interface BlogFrontmatter {
  title: string
  slug: string
  description: string
  date: Date
  updated?: Date
  tags?: string[]
  ogImage?: string
  draft?: boolean
  canonical?: string
  author?: { name: string; id: string }
  faq?: { q: string; a: string }[]
}

interface Props {
  data: BlogFrontmatter
  /** Heading tree from render(post); drives the wide-screen "On this page" TOC. */
  headings?: { depth: number; slug: string; text: string }[]
  /** Estimated reading time (minutes) for the byline. */
  readingMinutes?: number
}

const { data, headings = [], readingMinutes } = Astro.props

// On-this-page TOC entries (h2/h3 only; the H1 is the page title). Only switch
// to the wide three-column reading frame when a post has enough sections to
// make a TOC worthwhile; short posts keep the centered single column (so we
// never widen into an empty right gutter). Heading `slug`s match the ids Astro
// injects into the rendered headings, so the anchors resolve.
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3)
const showToc = toc.length >= 3
// Scoped to lg+: < lg stays byte-identical to the original centered layout.
const frameWide = showToc ? 'max-w-3xl lg:max-w-5xl' : 'max-w-3xl'

const selfUrl = `${SITE_URL}/blog/${data.slug}`

// End-of-post CTA: lead with the cert the post is actually about (from its
// tags), so an AIF-only post does not push readers primarily toward CLF. Both
// links stay present (the secondary "Try" path keeps the internal-link graph
// intact). Default CLF-first when the tags do not disambiguate (e.g. the
// comparison post tagged both).
const postTags = data.tags ?? []
const aifLed = postTags.includes('aif-c01') && !postTags.includes('clf-c02')
const ctaPrimary = aifLed
  ? { href: '/aws/aif-c01/practice-exam', label: 'Start an AIF-C01 practice exam' }
  : { href: '/aws/clf-c02/practice-exam', label: 'Start a CLF-C02 practice exam' }
const ctaSecondary = aifLed
  ? { href: '/aws/clf-c02/practice-exam', label: 'Try CLF-C02' }
  : { href: '/aws/aif-c01/practice-exam', label: 'Try AIF-C01' }
const canonical = data.canonical ?? selfUrl
// Per-post OG image when the frontmatter sets one; otherwise the blog-wide
// composite (generated by generate-og-images.mjs). Never the CLF-themed
// platform og-image.png, which would mismatch every post (R4.2).
const ogImage = `${SITE_URL}${data.ogImage ?? '/og/og-blog.png'}`
const datePublished = data.date.toISOString()
const dateModified = (data.updated ?? data.date).toISOString()

const breadcrumbItems = [
  { label: 'Home', to: '/' },
  { label: 'Blog', to: '/blog' },
  { label: data.title },
]

const blogPostingJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${selfUrl}#article`,
  headline: data.title,
  description: data.description,
  datePublished,
  dateModified,
  url: selfUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'en',
  author: { '@type': 'Person', '@id': 'https://www.cloudcertprep.io/#author' },
  publisher: { '@id': 'https://www.cloudcertprep.io/#organization' },
  ...(ogImage ? { image: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 } } : {}),
  ...(data.tags && data.tags.length > 0 ? { keywords: data.tags.join(', ') } : {}),
})

// Optional FAQPage graph, built from the post's `faq` frontmatter. Google
// retired the FAQ rich result, but answer engines (ChatGPT, Perplexity,
// Gemini) still read FAQPage Q&A when citing sources, so it stays a useful
// signal. Author the same Q&A visibly in the post body (kept in sync).
const faqJsonLd =
  data.faq && data.faq.length > 0
    ? serializeJsonLd({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${selfUrl}#faq`,
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      })
    : null

const publishedDisplay = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const updatedDisplay = data.updated
  ? data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  jsonLd={faqJsonLd ? [blogPostingJsonLd, faqJsonLd] : [blogPostingJsonLd]}
  headerOverlay={true}
>
  <Fragment slot="head">
    {/* Article-namespace Open Graph tags (audit W1). og:type=article is set
        below; these carry the freshness + author + tag signals that social
        platforms and LLM browse-mode read separately from the BlogPosting
        JSON-LD. RSS autodiscovery is emitted site-wide by BaseLayout. */}
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time" content={dateModified} />
    <meta property="article:author" content="https://santonastaso.me" />
    {data.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  {/* BreadcrumbList JSON-LD only; the long post title would wrap badly in a
      visible trail on mobile, and it already appears as the H1 below. */}
  <Breadcrumb items={breadcrumbItems} visuallyHidden />

  {/* Dark-stage article header (coherent with the blog index + about /
      contribute / legal HeroMini heroes). The post title is the stage H1. */}
  <article>
    <section class="stage relative overflow-hidden -mt-[calc(3rem+1px)] md:-mt-[calc(3.5rem+1px)]">
      {/* pb clears the .sheet-overlap (-3rem) so the tags/byline are never
          clipped by the content sheet sliding up over the header. */}
      <div class={`relative ${frameWide} mx-auto px-4 md:px-8 pt-24 md:pt-32 pb-16 md:pb-20`}>
        {/* When the wide TOC frame is active, left-align the header on lg so the
            title's left edge lines up with the body prose column below. */}
        <header class={`stagger max-w-[68ch] mx-auto${showToc ? ' lg:mx-0' : ''}`}>
          <nav class="font-mono text-[12px] tracking-wide text-[#8B95A3]" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#C9D2DC] transition-colors">Home</a>
            <span class="mx-1.5 text-white/25">›</span>
            <a href="/blog" class="hover:text-[#C9D2DC] transition-colors">Blog</a>
          </nav>

          <p class="mt-5 font-mono text-[12px] tracking-wide text-[#8B95A3]">
            <time datetime={datePublished}>{publishedDisplay}</time>
            {updatedDisplay && (
              <span>{' · Updated '}<time datetime={dateModified}>{updatedDisplay}</time></span>
            )}
          </p>

          <h1 class="font-display mt-3 text-[1.75rem] leading-[1.12] md:text-[2.5rem] font-bold tracking-[-0.025em] text-[#F4F6F8]">{data.title}</h1>

          <p class="mt-4 text-sm text-[#9AA6B2]">
            By <a href="https://santonastaso.me" class="text-[#C9D2DC] underline underline-offset-2 hover:text-white transition-colors">Alex Santonastaso</a>
            {readingMinutes && <span>{' · '}{readingMinutes} min read</span>}
          </p>

          {data.tags && data.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2 list-none p-0 m-0">
              {data.tags.map((tag) => (
                <li class="font-mono text-[11px] px-2.5 py-1 rounded-full bg-white/[0.05] border border-white/12 text-[#C9D2DC]">#{tag}</li>
              ))}
            </ul>
          )}
        </header>
      </div>
    </section>

    <div class="sheet-overlap pb-16 md:pb-24 pt-10 md:pt-14">
      <div class={`${frameWide} mx-auto px-4 md:px-8`}>
        {/* Wide screens: prose column + a sticky "On this page" rail that fills
            the otherwise-empty right gutter (the owner's 1440p complaint). The
            prose measure stays 68ch. < lg and short posts keep a single
            centered column (no grid, no rail). */}
        <div class={showToc ? 'lg:grid lg:grid-cols-[minmax(0,68ch)_1fr] lg:gap-12' : ''}>
          {showToc && (
            // Mobile / tablet "On this page": the wide-screen rail is hidden
            // below lg, so a collapsible native <details> gives the same jump
            // links without a sticky sidebar. lg:hidden -> removed from the grid
            // entirely on wide screens (display:none items don't form a track),
            // so the 2-column rail layout is unaffected. (M3 [C])
            <details class="lg:hidden mb-8 max-w-[68ch] mx-auto rounded-xl border border-border-hairline bg-bg-card/70">
              <summary class="flex items-center justify-between gap-2 cursor-pointer list-none px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-text-muted [&::-webkit-details-marker]:hidden">
                On this page
                <svg class="w-4 h-4 transition-transform duration-gentle [details[open]_&]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <ul class="list-none p-0 m-0 px-4 pb-3 space-y-0.5">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link
                      class={`block py-1 text-sm leading-snug text-text-muted transition-colors duration-200 hover:text-text-primary [&[data-active=true]]:text-text-primary [&[data-active=true]]:font-medium ${h.depth === 3 ? 'pl-4' : ''}`}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <div class={`blog-content max-w-[68ch] mx-auto${showToc ? ' lg:mx-0 [&_:is(h2,h3)]:scroll-mt-24' : ''}`}>
            <slot />
          </div>
          {showToc && (
            <aside class="hidden lg:block" aria-label="Table of contents">
              <nav class="sticky top-24">
                <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-text-muted mb-3">
                  On this page
                </p>
                <ul class="space-y-1 list-none p-0 m-0 border-l border-border-hairline">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link
                        class={`-ml-px block border-l border-transparent py-1 text-sm leading-snug text-text-muted transition-colors duration-200 hover:border-text-muted hover:text-text-primary focus-visible:outline-none focus-visible:border-text-muted focus-visible:text-text-primary [&[data-active=true]]:border-text-primary [&[data-active=true]]:text-text-primary [&[data-active=true]]:font-medium ${h.depth === 3 ? 'pl-6' : 'pl-3'}`}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )}
        </div>

        {/* End-of-post CTA: close the funnel (a post's job is to push readers
            into practice) and fill the dead band before the footer. Aligned to
            the prose column (lg:mx-0 under the wide TOC frame). */}
        <aside class={`mt-14 md:mt-20 max-w-[68ch] mx-auto${showToc ? ' lg:mx-0' : ''}`}>
          <div class="rounded-2xl border border-border-hairline bg-bg-card shadow-card p-6 md:p-8 text-center">
            <h2 class="text-xl md:text-2xl font-semibold tracking-[-0.01em] text-text-primary">Ready to put this into practice?</h2>
            <p class="mt-2 text-text-muted">Free, full-length practice exams with every answer explained. No signup required.</p>
            <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href={ctaPrimary.href} class={buttonClass({ variant: 'brand', size: 'lg' })}>{ctaPrimary.label}</a>
              <a href={ctaSecondary.href} class={buttonClass({ variant: 'secondary', size: 'lg' })}>{ctaSecondary.label}</a>
            </div>
          </div>
          <div class="mt-6 text-center">
            <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-text-muted hover:text-text-primary transition-colors">
              <span aria-hidden="true">←</span> Back to all posts
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {/* Scroll-spy: highlight the heading currently at the top of the viewport in
      both the desktop rail and the mobile <details> TOC. The IntersectionObserver
      only acts as a cheap "a heading crossed the top" trigger; the active heading
      is recomputed by position so it stays correct scrolling up AND down. No-ops
      on posts without a TOC (no [data-toc-link] nodes). State only, no motion, so
      it is reduced-motion-safe. (M3 [C]) */}
  <script>
    const links = Array.from(document.querySelectorAll('[data-toc-link]'))
    if (links.length) {
      const idOf = (l: Element) => l.getAttribute('href')?.slice(1) || ''
      const ids = new Set(links.map(idOf))
      const headings = Array.from(
        document.querySelectorAll('.blog-content h2, .blog-content h3')
      ).filter((h) => h.id && ids.has(h.id)) as HTMLElement[]

      let activeId: string | null = null
      const setActive = (id: string) => {
        if (id === activeId) return
        activeId = id
        for (const l of links) {
          if (idOf(l) === id) {
            l.setAttribute('data-active', 'true')
            l.setAttribute('aria-current', 'location')
          } else {
            l.removeAttribute('data-active')
            l.removeAttribute('aria-current')
          }
        }
      }

      const update = () => {
        let current = headings[0]?.id
        for (const h of headings) {
          if (h.getBoundingClientRect().top - 120 <= 0) current = h.id
          else break
        }
        if (current) setActive(current)
      }

      const io = new IntersectionObserver(update, {
        rootMargin: '-120px 0px 0px 0px',
        threshold: [0, 1],
      })
      headings.forEach((h) => io.observe(h))
      update()
    }
  </script>
</BaseLayout>
