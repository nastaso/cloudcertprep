---
/**
 * BlogLayout.astro — wraps a single blog post.
 *
 * Emits BlogPosting JSON-LD anchored to the Person entity (@id) in the
 * BaseLayout graph, renders a breadcrumb trail, and delegates page chrome,
 * meta tags, and platform JSON-LD to BaseLayout. The post body is rendered
 * via the default <slot />.
 *
 * Canonical is self-referential (https://www.cloudcertprep.io/blog/<slug>)
 * unless frontmatter.canonical overrides it.
 *
 * Emits article-namespace Open Graph meta (published/modified time, author,
 * tags) into <head> via BaseLayout's named `head` slot. RSS autodiscovery is
 * emitted site-wide by BaseLayout (R4.17).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { SITE_URL } from '../lib/seo-data'
import { serializeJsonLd } from '../lib/jsonld'

interface BlogFrontmatter {
  title: string
  slug: string
  description: string
  date: Date
  updated?: Date
  tags?: string[]
  ogImage?: string
  draft?: boolean
  canonical?: string
  author?: { name: string; id: string }
}

interface Props {
  data: BlogFrontmatter
}

const { data } = Astro.props

const selfUrl = `${SITE_URL}/blog/${data.slug}`
const canonical = data.canonical ?? selfUrl
// Per-post OG image when the frontmatter sets one; otherwise the blog-wide
// composite (generated by generate-og-images.mjs). Never the CLF-themed
// platform og-image.png, which would mismatch every post (R4.2).
const ogImage = `${SITE_URL}${data.ogImage ?? '/og/og-blog.png'}`
const datePublished = data.date.toISOString()
const dateModified = (data.updated ?? data.date).toISOString()

const breadcrumbItems = [
  { label: 'Home', to: '/' },
  { label: 'Blog', to: '/blog' },
  { label: data.title },
]

const blogPostingJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${selfUrl}#article`,
  headline: data.title,
  description: data.description,
  datePublished,
  dateModified,
  url: selfUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Person', '@id': 'https://www.cloudcertprep.io/#author' },
  publisher: { '@id': 'https://www.cloudcertprep.io/#organization' },
  ...(ogImage ? { image: ogImage } : {}),
  ...(data.tags && data.tags.length > 0 ? { keywords: data.tags.join(', ') } : {}),
})

const publishedDisplay = data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const updatedDisplay = data.updated
  ? data.updated.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
  : null
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  jsonLd={[blogPostingJsonLd]}
  headerOverlay={true}
>
  <Fragment slot="head">
    {/* Article-namespace Open Graph tags (audit W1). og:type=article is set
        below; these carry the freshness + author + tag signals that social
        platforms and LLM browse-mode read separately from the BlogPosting
        JSON-LD. RSS autodiscovery is emitted site-wide by BaseLayout. */}
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time" content={dateModified} />
    <meta property="article:author" content="https://santonastaso.me" />
    {data.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  {/* BreadcrumbList JSON-LD only; the long post title would wrap badly in a
      visible trail on mobile, and it already appears as the H1 below. */}
  <Breadcrumb items={breadcrumbItems} visuallyHidden />

  {/* Dark-stage article header (coherent with the blog index + about /
      contribute / legal HeroMini heroes). The post title is the stage H1. */}
  <article>
    <section class="stage relative overflow-hidden -mt-[calc(3rem+1px)] md:-mt-[calc(3.5rem+1px)]">
      {/* pb clears the .sheet-overlap (-3rem) so the tags/byline are never
          clipped by the content sheet sliding up over the header. */}
      <div class="relative max-w-3xl mx-auto px-4 md:px-8 pt-24 md:pt-32 pb-16 md:pb-20">
        <header class="stagger max-w-[68ch] mx-auto">
          <nav class="font-mono text-[12px] tracking-wide text-[#8B95A3]" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#C9D2DC] transition-colors">Home</a>
            <span class="mx-1.5 text-white/25">›</span>
            <a href="/blog" class="hover:text-[#C9D2DC] transition-colors">Blog</a>
          </nav>

          <p class="mt-5 font-mono text-[12px] tracking-wide text-[#8B95A3]">
            <time datetime={datePublished}>{publishedDisplay}</time>
            {updatedDisplay && (
              <span>{' · Updated '}<time datetime={dateModified}>{updatedDisplay}</time></span>
            )}
          </p>

          <h1 class="font-display mt-3 text-[1.75rem] leading-[1.12] md:text-[2.5rem] font-bold tracking-[-0.025em] text-[#F4F6F8]">{data.title}</h1>

          <p class="mt-4 text-sm text-[#9AA6B2]">
            By <a href="https://santonastaso.me" class="text-[#C9D2DC] underline underline-offset-2 hover:text-white transition-colors">Alex Santonastaso</a>
          </p>

          {data.tags && data.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2 list-none p-0 m-0">
              {data.tags.map((tag) => (
                <li class="font-mono text-[11px] px-2.5 py-1 rounded-full bg-white/[0.05] border border-white/12 text-[#C9D2DC]">#{tag}</li>
              ))}
            </ul>
          )}
        </header>
      </div>
    </section>

    <div class="sheet-overlap pb-16 md:pb-24 pt-10 md:pt-14">
      <div class="max-w-3xl mx-auto px-4 md:px-8">
        <div class="blog-content max-w-[68ch] mx-auto">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
