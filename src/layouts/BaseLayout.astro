---
import '../index.css'
import AnalyticsBootstrap from '../components/AnalyticsBootstrap.tsx'
import Header from '../components/Header.astro'
import FooterIsland from '../components/FooterIsland.tsx'
import DonateButtonIsland from '../components/DonateButtonIsland.tsx'
import AccountLinkNoticeIsland from '../components/AccountLinkNoticeIsland.tsx'
import SchemaOrgJsonLd from '../components/SchemaOrgJsonLd.astro'
import { BASE_GRAPH_NODES } from '../lib/base-graph'
import { SITE_URL } from '../lib/seo-data'

interface Props {
  title: string
  description: string
  canonical: string
  ogImage?: string
  ogType?: string
  robots?: string
  jsonLd?: string[]
  /**
   * Whether to render the global chrome (Header, Footer, DonateButton).
   * Interactive island pages that manage their own layout (e.g. the exam
   * flow) can opt out. Defaults to true. AnalyticsBootstrap always renders
   * regardless. (The cookie-consent banner is currently unmounted; analytics is
   * cookieless Umami only.)
   */
  showChrome?: boolean
  /** Whether the Header shows its full nav (cert switcher + links). Default true. */
  headerShowNav?: boolean
  /** Billboard overlay header (transparent → frosted on scroll). Hero pages only. */
  headerOverlay?: boolean
  /**
   * Suppress the cc-authed frost rule so the transparent overlay is preserved
   * for signed-in users. Pass true for pages whose dark hero is always visible
   * regardless of auth state (e.g. coming-soon cert landings).
   */
  headerNoAuthedFrost?: boolean
  /**
   * Whether the Header sticks to the top of the viewport on scroll. Default
   * true. Disabled on the mock-exam shell, whose in-page exam toolbar already
   * owns `sticky top-0`; two sticky bars at top-0 would overlap.
   */
  headerSticky?: boolean
  /**
   * Render the no-JS site-directory fallback block. Default false: prerendered
   * marketing/content pages are fully readable without JS, so the directory
   * would only duplicate content (and a second raw-HTML <h1>) for crawlers.
   * The interactive island shells (login, reset-password, history,
   * practice-exam, domain-practice) pass true because their body is empty
   * without JavaScript.
   */
  noscriptDirectory?: boolean
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://www.cloudcertprep.io/og-image.png',
  ogType = 'website',
  robots = 'index, follow',
  jsonLd = [],
  showChrome = true,
  headerShowNav = true,
  headerOverlay = false,
  headerNoAuthedFrost = false,
  headerSticky = true,
  noscriptDirectory = false,
} = Astro.props

const umamiWebsiteId = import.meta.env.VITE_UMAMI_WEBSITE_ID ?? ''
// Umami host. Defaults to Umami Cloud; set VITE_UMAMI_HOST to a self-hosted
// instance (e.g. https://analytics.cloudcertprep.io) to point the beacon there.
// The chosen host must also be allowlisted in public/_headers (script-src +
// connect-src) or the CSP will block the script and its /api/send posts.
const umamiHost = import.meta.env.VITE_UMAMI_HOST ?? 'https://cloud.umami.is'
const gaMeasurementId = import.meta.env.VITE_GA_MEASUREMENT_ID ?? ''

// Pre-promotion noindex preview gate (R9.17, Property 7). Non-production
// Cloudflare Pages preview deployments set PUBLIC_NOINDEX=true (via the Preview
// environment variables), which bakes noindex into every prerendered page here,
// regardless of each page's intended robots value. Production leaves
// PUBLIC_NOINDEX unset, so indexable routes emit their real robots value
// untouched.
const isNoindexPreview = import.meta.env.PUBLIC_NOINDEX === 'true'
const effectiveRobots = isNoindexPreview ? 'noindex' : robots
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FF9900" />

    <!-- Preconnect to external origins (improves LCP) -->
    <link rel="preconnect" href={umamiHost} />
    <link rel="dns-prefetch" href={umamiHost} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Alex Santonastaso" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="CloudCertPrep" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Additional SEO -->
    <meta name="robots" content={effectiveRobots} />
    {/* On noindex previews (branch deploys / deploy previews) the real robots
        value is preserved here so postbuild guards (validate-internal-graph)
        can validate the INTENDED production structure. Never emitted in
        production; crawlers ignore unknown meta names regardless. */}
    {isNoindexPreview && <meta name="x-intended-robots" content={robots} />}
    {/* Canonical is suppressed on noindex pages: emitting a self-canonical
        alongside noindex is a contradictory signal (canonical = "index this as
        authoritative", noindex = "do not index"). Google's guidance is to omit
        canonical on noindex pages. (audit W6) */}
    {!effectiveRobots.includes('noindex') && <link rel="canonical" href={canonical} />}

    {/* Site-wide RSS autodiscovery so feed readers and LLM browse-mode can find
        the blog feed from any page, not just /blog. (audit W10) */}
    <link rel="alternate" type="application/rss+xml" title="CloudCertPrep Blog" href={`${SITE_URL}/blog/rss.xml`} />

    {/* TODO(W16): add <meta name="twitter:site"> / <meta name="twitter:creator">
        once an official X/Twitter handle exists. Not invented here. */}

    <!-- Platform-level structured data (cert-agnostic): WebSite, Organization,
         and the standalone Person entity that anchors the E-E-A-T signal.
         Sourced from src/lib/base-graph.ts (single source of truth) and guarded
         byte-identical across every page by scripts/check-person-graph.mjs. -->
    {BASE_GRAPH_NODES.map((node) => (
      <SchemaOrgJsonLd data={node} />
    ))}

    <!-- Additional per-page JSON-LD -->
    {jsonLd.map((ld) => (
      <script type="application/ld+json" set:html={ld} />
    ))}

    <!-- Umami Analytics (cookieless, GDPR-friendly, runs without consent) -->
    <script is:inline define:vars={{ umamiWebsiteId, umamiHost }}>
      (function(){
        var id=umamiWebsiteId;
        if(!id||id.charAt(0)==='%')return;
        var s=document.createElement('script');
        s.defer=true;
        s.src=umamiHost+'/script.js';
        s.setAttribute('data-website-id',id);
        document.head.appendChild(s);
      })();
    </script>

    <!-- Google Analytics (deferred until interactive, requires consent).
         Currently DORMANT: the consent banner is hidden (CookieConsentIsland is
         unmounted in this file) and VITE_GA_MEASUREMENT_ID is unset, so this
         never loads. To re-enable: set the env var, re-mount the banner, and
         re-add the GA hosts to the CSP in public/_headers (script-src
         googletagmanager + connect-src google-analytics). -->
    <script is:inline define:vars={{ gaMeasurementId }}>
      (function(){
        var id=gaMeasurementId;
        if(!id||id.charAt(0)==='%')return;

        // Check for cookie consent
        var consent=localStorage.getItem('cloudcertprep_cookie_consent');
        if(consent!=='accepted')return;

        function load(){
          window.dataLayer=window.dataLayer||[];
          window.gtag=function(){dataLayer.push(arguments);};
          window.gtag('js',new Date());
          window.gtag('config',id);
          var s=document.createElement('script');
          s.async=true;
          s.src='https://www.googletagmanager.com/gtag/js?id='+id;
          document.head.appendChild(s);
        }

        if('requestIdleCallback'in window){
          requestIdleCallback(load)
        }else{
          setTimeout(load,1)
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <!-- FOUC prevention: DO NOT REMOVE -->
    <script is:inline>
      /* Light default. Dark only when the user explicitly chose it via the
         theme toggle (stored only on explicit toggle, never auto-persisted;
         no OS prefers-color-scheme mirroring by design). */
      (function(){var t=localStorage.getItem('cloudcertprep_theme');if(t==='dark'){document.documentElement.classList.add('dark')}})();
      /* Motion gate, set BEFORE first paint so the hero stagger + scroll-reveal
         elements ([data-reveal]) are hidden from frame ONE (deterministic - no
         paint-then-snap-to-0 flash, which was racy when cc-js was added at the
         end of <body>). Only when motion is allowed AND IntersectionObserver
         exists; otherwise content paints fully visible (no-JS / reduced-motion /
         old-browser parity). The end-of-body bootstrap then reveals it.
         DO NOT REMOVE. */
      (function(){try{if(!(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)&&'IntersectionObserver'in window){document.documentElement.classList.add('cc-js')}}catch(e){}})();
    </script>

    <!-- Auth pre-paint: define a shared hasSession() helper on window, then
         apply the `cc-authed` class to <html> before paint. Logged-in
         visitors see History + Sign out immediately (no flash, no shift).
         The class is ALSO set optimistically on an OAuth / magic-link return
         (`?code=` in the URL): the session token is not written yet (Supabase
         exchanges the code AFTER load - the same `hasAuthCallback` test as
         useAuth.ts), so without this the home/cert page paints the GUEST hero
         then hard-cuts to the signed-in view ~1s later when the PKCE exchange
         resolves (flash F1, plus a dark->light tone change in light theme).
         The guest markup only CSS-hides (it is never removed), and crawlers
         never see a `?code=` URL, so the build-time HTML keeps the locked H1 as
         the first <h1> (citation guard). A failed exchange flips back to guest
         when HeaderInteractive re-syncs to the real auth result (rarer than
         today's every-success flash; failures navigate away anyway). Header
         readability + hero swap on the optimistic class are pure CSS
         (index.css `html.cc-authed header[data-overlay]` + `.cc-auth-*`).
         __ccHasSession() itself stays a PURE token check - cert.astro + the
         index.astro greeting read it for the real stored user. Runs on bfcache
         restore (pageshow) too. DO NOT REMOVE. -->
    <script is:inline>
      (function(){function h(){try{for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(k&&k.indexOf('sb-')===0&&k.indexOf('-auth-token')===k.length-11)return true}}catch(e){}return false}window.__ccHasSession=h;function apply(){document.documentElement.classList.toggle('cc-authed',h()||/[?&]code=/.test(location.search))}apply();window.addEventListener('pageshow',apply)})();
    </script>

    <!-- Stale-chunk recovery: after a new deploy, a still-open old tab can
         request a hashed chunk that no longer exists. Vite fires
         `vite:preloadError` on the failed dynamic import; reload once (guarded by
         a 10s timestamp so a permanently-missing chunk can never loop) to fetch
         the current app. Inline so the CSP-hash generator covers it. DO NOT REMOVE. -->
    <script is:inline>
      (function(){window.addEventListener('vite:preloadError',function(e){try{e.preventDefault()}catch(_){}var now=Date.now(),last=0;try{last=+sessionStorage.getItem('cc-chunk-reload')||0}catch(_){}if(now-last<10000)return;try{sessionStorage.setItem('cc-chunk-reload',String(now))}catch(_){}location.reload()})})();
    </script>

    <div class="min-h-screen bg-bg-dark flex flex-col">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand focus:text-on-brand focus:rounded focus:font-medium"
      >
        Skip to main content
      </a>

      {showChrome && <Header showNav={headerShowNav} sticky={headerSticky} overlay={headerOverlay} noAuthedFrost={headerNoAuthedFrost} />}

      <main id="main" class="flex-1 flex flex-col">
        <slot />
      </main>

      {showChrome && <FooterIsland client:idle />}
      {showChrome && <DonateButtonIsland client:idle pathname={Astro.url.pathname} />}
    </div>

    <AccountLinkNoticeIsland client:idle />
    {/* client:idle (was client:load): analytics is non-critical, keep its
        hydration off the critical path. Inline consumers of
        window.trackEvent must tolerate late exposure (404.astro polls). */}
    <AnalyticsBootstrap client:idle />

    {/* Progressive-enhancement motion bootstrap (§8 item 3): marks <html> with
        `cc-js` so the scroll-reveal CSS only applies when JS runs (no-JS users
        and crawlers always see fully-visible content), then reveals
        [data-reveal] elements as they scroll into view. Reduced-motion users
        get the content immediately (the transition is neutralised globally and
        we reveal everything up-front). Inline so the CSP-hash generator covers
        it. */}
    <script is:inline>
      (function () {
        var root = document.documentElement
        /* cc-js is set pre-paint in <head>, but ONLY when motion is allowed +
           IntersectionObserver exists. If it is absent (reduced-motion / no-IO /
           no-JS parity) the content is already fully visible - nothing to do. */
        if (!root.classList.contains('cc-js')) return
        var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'))
        if (!els.length) return
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-revealed'); io.unobserve(e.target) }
          })
        }, { rootMargin: '0px 0px -10% 0px' })
        /* This runs at end-of-body parse, before the first paint of these
           elements in practice. Reveal anything already in/near the viewport
           SYNCHRONOUSLY so above-the-fold reveals never sit blank; observe only
           the genuinely below-fold ones (hidden off-screen => no visible flash
           when they later reveal on scroll). */
        var vh = window.innerHeight || root.clientHeight
        els.forEach(function (el) {
          if (el.getBoundingClientRect().top < vh) el.classList.add('is-revealed')
          else io.observe(el)
        })
      })()
    </script>
    {noscriptDirectory && <noscript>
      <style>
        .cc-no { font-family: system-ui, -apple-system, sans-serif; max-width: 720px; margin: 0 auto; padding: 2rem 1rem; line-height: 1.6; color: #1c1917; }
        .cc-no h1 { color: #FF9900; margin: 0 0 0.5rem; font-size: 1.875rem; }
        .cc-no h2 { font-size: 1.25rem; margin: 0 0 0.75rem; color: #1c1917; }
        .cc-no a { color: #1c1917; text-decoration: underline; }
        .cc-no .muted { color: #57534E; }
        .cc-no header { text-align: center; margin-bottom: 2rem; }
        .cc-no section { margin-bottom: 2rem; }
        .cc-no footer { text-align: center; color: #57534E; font-size: 0.875rem; border-top: 1px solid #e7e5e4; padding-top: 1rem; }
        .cc-no ul { margin: 0; padding-left: 1.5rem; }
      </style>
      <div class="cc-no">
        <header>
          <h1>CloudCertPrep</h1>
          <p class="muted" style="margin: 0;">Free Cloud Certification Practice Exams</p>
        </header>

        <section>
          <p style="margin: 0 0 1rem;">CloudCertPrep is a free, open-source web application for preparing for cloud certifications. It provides full-length timed mock exams, domain-by-domain practice with adaptive spaced repetition, and progress tracking across every supported certification.</p>
          <p style="margin: 0;"><strong>Marketing pages, blog posts, and per-domain study content render without JavaScript.</strong> Follow the links below to read them. The interactive practice exam and domain practice flows do require JavaScript to manage timing, scoring, and progress.</p>
        </section>

        <section>
          <h2>How CloudCertPrep works</h2>
          <ul>
            <li><strong>Mock exam:</strong> full-length, randomly selected questions, exactly mirroring the real exam format for the certification you choose. Scaled scoring with the cert's official passing threshold.</li>
            <li><strong>Domain practice:</strong> focused study by exam domain with instant feedback, explanations, and spaced repetition for signed-in users.</li>
            <li><strong>History:</strong> review past attempts and see domain mastery breakdowns.</li>
          </ul>
        </section>

        <section>
          <h2>Supported certifications</h2>
          <ul>
            <li><a href="https://www.cloudcertprep.io/aws/clf-c02">AWS Certified Cloud Practitioner (CLF-C02)</a> &mdash; foundational AWS cert. 1,050+ practice questions across 4 domains.</li>
            <li><a href="https://www.cloudcertprep.io/aws/aif-c01">AWS Certified AI Practitioner (AIF-C01)</a> &mdash; foundational AI/ML cert. 5 domains covering AI fundamentals, generative AI, foundation models, responsible AI, and security.</li>
          </ul>
        </section>

        <section>
          <h2>Privacy and Terms</h2>
          <p style="margin: 0 0 0.75rem;">CloudCertPrep is GDPR-compliant. Guest users generate no server-side data. Authenticated user data is stored in the EU (Supabase, Ireland) and never sold or shared. Read the full <a href="https://www.cloudcertprep.io/privacy">Privacy Policy</a> and <a href="https://www.cloudcertprep.io/terms">Terms of Service</a>.</p>
        </section>

        <section>
          <h2>Pages on this site</h2>
          <ul>
            <li><a href="https://www.cloudcertprep.io/">Home</a></li>
            <li><a href="https://www.cloudcertprep.io/about">About</a></li>
            <li><a href="https://www.cloudcertprep.io/aws/clf-c02">AWS Cloud Practitioner (CLF-C02)</a></li>
            <li><a href="https://www.cloudcertprep.io/aws/aif-c01">AWS AI Practitioner (AIF-C01)</a></li>
            <li><a href="https://www.cloudcertprep.io/blog">Blog</a></li>
            <li><a href="https://www.cloudcertprep.io/contribute">Contribute</a></li>
            <li><a href="https://www.cloudcertprep.io/history">Exam history</a></li>
            <li><a href="https://www.cloudcertprep.io/privacy">Privacy Policy</a></li>
            <li><a href="https://www.cloudcertprep.io/terms">Terms of Service</a></li>
          </ul>
        </section>

        <footer>
          <p style="margin: 0 0 0.25rem;">CloudCertPrep is created by <a href="https://santonastaso.me">Alex Santonastaso</a> and is open source on <a href="https://github.com/nastaso/cloudcertprep">GitHub</a>.</p>
          <p style="margin: 0;">Not affiliated with Amazon Web Services or Amazon.com, Inc. AWS and related trademarks belong to Amazon.</p>
        </footer>
      </div>
    </noscript>}
  </body>
</html>
