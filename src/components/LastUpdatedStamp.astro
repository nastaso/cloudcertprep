---
/**
 * LastUpdatedStamp.astro — a small muted "Last updated" / alignment line.
 *
 * Derives the month + year from the `lastmod` prop (an ISO YYYY-MM-DD content-
 * change date from the freshness ledger, src/data/bank-lastmod.json) so a pure
 * redeploy never refreshes the visible date. When no `lastmod` is supplied
 * (non-cert callers such as /about, which key off no question bank) it falls
 * back to the build timestamp (`new Date()`) as before.
 *
 * When an `examGuideVersion` is supplied (e.g. 'AIF-C01 (1.1, April 2026)'),
 * the stamp renders an exam-guide alignment statement:
 *   "✓ Aligned to the <CERT_CODE> exam guide (version <version>). Last verified <Month Year>."
 * The leading "✓" is a literal UTF-8 check-mark character, not an icon
 * component. The `examGuideVersion` string is
 * parsed into its code (everything before " (") and version (inside the
 * parens); if it does not match the expected `CODE (version)` shape it falls
 * back to rendering the whole string as the code with no version parens (used
 * by CLF-C02, whose AWS guide publishes no version number).
 *
 * When an `examGuideUrl` is supplied, the phrase "exam guide" becomes an
 * outbound `rel="noopener"` link to the official AWS guide — an authoritative
 * citation / E-E-A-T signal.
 *
 * When no `examGuideVersion` is supplied, the stamp reads
 * "Last updated: <Month Year>".
 *
 * Satisfies: R17.5, R23.3.
 */
interface Props {
  /**
   * Optional exam-guide version label, e.g. 'AIF-C01 (1.1, April 2026)' or a
   * bare code like 'CLF-C02' when the guide carries no version. When provided,
   * the stamp renders the "✓ Aligned to the <code> exam guide …" line.
   */
  examGuideVersion?: string
  /**
   * Optional official AWS exam-guide URL. When provided, "exam guide" renders
   * as an outbound link to it.
   */
  examGuideUrl?: string
  /**
   * Optional ISO YYYY-MM-DD content-change date from the freshness ledger
   * (getCertLastmod). When provided, the visible month/year reflects the bank's
   * real last-updated date instead of the build/deploy date. Omitted callers
   * fall back to the current date.
   */
  lastmod?: string
}

const { examGuideVersion, examGuideUrl, lastmod } = Astro.props

// Derive "Month Year" from the ledger date when supplied, else the build
// timestamp. Parse the ISO date into local Y/M parts (day pinned to 1) so a
// non-UTC build timezone can never shift the month at a month boundary.
function toMonthYear(iso?: string): string {
  if (iso && /^\d{4}-\d{2}-\d{2}$/.test(iso)) {
    const [year, month] = iso.split('-').map(Number)
    return new Date(year, month - 1, 1).toLocaleDateString('en-US', {
      month: 'long',
      year: 'numeric',
    })
  }
  return new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
}
const monthYear = toMonthYear(lastmod)

// Parse the 'CODE (version)' label into its two parts. Group 1 is everything
// before " (", group 2 is the text inside the parens.
const match = examGuideVersion?.match(/^(.+?)\s*\((.+)\)\s*$/)
const certCode = match ? match[1] : examGuideVersion
const version = match ? match[2] : undefined
---

<p class="text-xs text-text-muted">
  {examGuideVersion ? (
    <>
      {'✓ Aligned to the '}{certCode}{' '}
      {examGuideUrl ? (
        <a
          href={examGuideUrl}
          target="_blank"
          rel="noopener"
          class="underline hover:text-text-primary rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-bg-dark"
        >exam guide</a>
      ) : (
        'exam guide'
      )}
      {version ? ` (version ${version})` : ''}
      {`. Last verified ${monthYear}.`}
    </>
  ) : (
    `Last updated: ${monthYear}`
  )}
</p>
