---
/**
 * Header.astro — solid AWS Console navy bar (#232F3E) used by BaseLayout on
 * every page. The logo + wordmark are static Astro markup (no React, no
 * hydration) so the chrome is in the HTML immediately and never flashes. The
 * platform tagline lives in the logo link's aria-label rather than as a
 * visible subheader (clean single-wordmark premium look; a11y/crawler context
 * preserved). The right-hand cluster (cert switcher, About/Blog/GitHub links,
 * History, auth button, mobile drawer) is the single `HeaderInteractive` island.
 *
 * Identity: the navy chrome + orange CTA pattern is AWS Console's own DNA,
 * so the site reads as AWS-affiliated on first paint without copying AWS
 * trade dress (which would be a legal problem). Brand orange #FF9900 is
 * reserved for the Sign-in pill, the logo cloud mark, and the body CTAs —
 * never for the chrome.
 */
import HeaderInteractive from './HeaderInteractive.tsx'

interface Props {
  /** When false, render only the logo (no nav cluster / island). Default true. */
  showNav?: boolean
  /** When true (default), the header sticks to the top of the viewport on scroll. */
  sticky?: boolean
  /**
   * Billboard overlay mode (home/cert heroes): the bar starts transparent
   * with white text over the hero, then frosts in after ~16px of scroll
   * (Apple pattern). A tiny inline script toggles .hdr-scrolled.
   */
  overlay?: boolean
}

const { showNav = true, sticky = true, overlay = false } = Astro.props

// Current request path, resolved at build time for each prerendered page.
// Passed into the island so the CertSwitcher renders the correct state in the
// SSR HTML (it's gated on the route being cert-scoped). Without this the
// switcher's useSyncExternalStore server snapshot is '/', so the pill is absent
// from the server HTML and only pops in after client:idle hydration — a visible
// load delay on cert pages and a flash on every navigation.
const pathname = Astro.url.pathname

const PLATFORM_TAGLINE = 'AWS Certification Exam Prep'

// Inline lucide icon paths (lucide-react is React-only).
const cloudPath = 'M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z'
const checkPath = 'M20 6 9 17l-5-5'
---

{/* Apple-style frosted chrome: translucent, heavy blur+saturate, slim bar.
    Content scrolls underneath; the bar reads as glass, not a slab. */}
<header
  id="site-header"
  data-overlay={overlay || undefined}
  class:list={[sticky ? "sticky top-0 z-40" : "relative z-30", "bg-header-bg/70 backdrop-blur-xl backdrop-saturate-150 border-b border-border-hairline/60 text-on-header"]}
>
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="flex items-center justify-between gap-4 h-12 md:h-14">
      {/* Logo + wordmark. The accessible name carries the platform tagline
          (previously a visible subheader) so the chrome reads as a clean
          single-wordmark (premium) while screen readers and crawlers still get
          the descriptive context. (audit-reconciliation: tagline → aria-label) */}
      <a href="/" class="flex items-center gap-2 md:gap-3 group" aria-label={`CloudCertPrep, ${PLATFORM_TAGLINE}, home`}>
        {/* Brand mark: white tile + orange cloud + white check — the live
            cloudcertprep.io mark, preserved on the navy bar for brand
            continuity. The tile stays white in both themes (the header is
            navy in both), so bg-white (not bg-bg-card, which flips dark). */}
        {/* Bare brand mark (same glyph as the favicon): orange cloud + white
            check, no tile. One presentation across favicon, header, and the
            OG/tile art pipeline. */}
        <div class="relative w-8 h-8 md:w-9 md:h-9 flex items-center justify-center group-active:scale-[0.97] transition-transform duration-gentle ease-press group-active:duration-press">
          <svg class="w-8 h-8 md:w-9 md:h-9 text-brand drop-shadow-[0_1px_6px_rgba(255,153,0,0.35)]" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={cloudPath} /></svg>
          <svg class="w-[18px] h-[18px] md:w-5 md:h-5 absolute translate-y-[1px]" viewBox="0 0 24 24" fill="none" stroke="#0E1116" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={checkPath} /></svg>
        </div>
        {/* Wordmark: bumped to text-xl/2xl so the cap-height balances the
            40px tile (premium lockups sit cap-height at ~60-70% of the icon,
            never matching the full square). Two-tone weight ("Cloud" medium +
            "CertPrep" bold) gives the compound name internal rhythm so it
            reads as a brand, not a label — the Vercel/PlanetScale treatment.
            translate-y-[4px] is a deliberate optical nudge: with leading-none
            the line-box centres geometrically, but the cap-height block sits
            ~1px high (descender space reserved at the bottom), so the visible
            letters read high against the tile without it. The
            accessible/visible string stays "CloudCertPrep" verbatim. */}
        <span class="font-display text-base md:text-lg text-on-header tracking-tight leading-none translate-y-[2px]">
          <span class="font-medium">Cloud</span><span class="font-semibold">CertPrep</span>
        </span>
      </a>

      {/* Right-hand cluster: cert switcher + links + auth + mobile drawer.
          Hydrated `client:idle`: the static chrome + the cc-authed pre-paint
          CSS already render the correct header for both auth states on first
          paint, so the React cost can defer until idle. */}
      {showNav && <HeaderInteractive client:idle initialPathname={pathname} />}
    </div>
  </div>
</header>

{overlay && (
  <script is:inline>
    // Overlay header: frost in after a small scroll. rAF-throttled; runs
    // before paint settles so there's no flash at non-zero scroll restores.
    (function () {
      var hdr = document.getElementById('site-header')
      if (!hdr) return
      var ticking = false
      function apply() {
        hdr.classList.toggle('hdr-scrolled', window.scrollY > 16)
        ticking = false
      }
      function onScroll() {
        if (!ticking) { ticking = true; requestAnimationFrame(apply) }
      }
      apply()
      window.addEventListener('scroll', onScroll, { passive: true })
    })()
  </script>
)}
