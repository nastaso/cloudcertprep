---
/**
 * TrustLine.astro — zero-guarded community pass-rate line.
 *
 * Renders the community trust line on the home page:
 *
 *   "{attempts} practice exam attempts · {passRate}% community pass rate"
 *
 * gated behind `attemptsCompleted > 0 && passRatePercent > 0`. An empty or
 * zero community renders nothing rather than a misleading "0%".
 *
 * Depends only on existing token classes — no brand color (brand-rarity), no
 * emoji glyphs. The consuming page
 * passes `snapshot.overall.attemptsCompleted` and `passRatePercent` from
 * `src/lib/generated/stats-snapshot.json`.
 */
interface Props {
  /** Total completed practice exam attempts from the stats snapshot. */
  attemptsCompleted: number
  /** Community pass rate as a whole-number percentage from the stats snapshot. */
  passRatePercent: number
}

const { attemptsCompleted, passRatePercent } = Astro.props

// Same zero-guard as production: omit the line entirely unless both figures
// are non-zero, so an empty community never shows a misleading "0%".
const showTrustLine = attemptsCompleted > 0 && passRatePercent > 0
---

{showTrustLine && (
  <p class="text-text-muted text-sm md:text-base">
    {attemptsCompleted.toLocaleString('en-US')} practice exam attempts · {passRatePercent}% community pass rate
  </p>
)}
