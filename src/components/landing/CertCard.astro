---
/**
 * CertCard.astro — prerendered cert tile linking to /<provider>/<certCode>.
 * Astro port of the React CertCard with identical Tailwind classes.
 */
import type { Certification } from '../../data/certifications'

interface Props {
  cert: Certification
  variant?: 'detailed' | 'compact'
}

const { cert, variant = 'detailed' } = Astro.props

const totalQs = cert.domains.reduce((s, d) => s + d.questionCount, 0)
const examMinutes = Math.round(cert.examTimeSeconds / 60)
const isComingSoon = cert.status === 'coming-soon'

const description = isComingSoon
  ? variant === 'detailed'
    ? `Question bank in progress; ${cert.domains.length}-domain coverage planned.`
    : 'Question bank in progress.'
  : variant === 'detailed'
    ? `${totalQs.toLocaleString('en-US')} practice questions, ${cert.examQuestionCount}-question mock exam in ${examMinutes} minutes.`
    : `${totalQs.toLocaleString('en-US')} questions, ${cert.examQuestionCount}-question exam in ${examMinutes} min.`
---

<a
  href={`/${cert.provider}/${cert.code}`}
  class:list={[
    'bg-bg-card hover:bg-bg-card-hover p-4 md:p-6 rounded-xl border-2 transition-colors duration-200 ease-out shadow-card block lift focus-visible:outline-none focus-visible:border-brand',
    isComingSoon ? 'border-brand/20 hover:border-brand/40' : 'border-transparent hover:border-brand/35',
  ]}
>
  <div class="flex items-center gap-2 mb-2">
    <span class="text-base md:text-lg font-semibold text-text-primary">{cert.shortName}</span>
    {isComingSoon && (
      <span class="px-2 py-0.5 rounded text-[10px] md:text-xs font-medium bg-brand text-on-brand">
        Coming soon
      </span>
    )}
  </div>
  <p class="text-sm md:text-base text-text-primary mb-3">{cert.name}</p>
  <p class="text-text-muted text-xs md:text-sm">{description}</p>
</a>
