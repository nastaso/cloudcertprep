---
/**
 * AboutCard.astro — "Built to mirror the real exam" feature grid (DSv5.2).
 * The single platform-pillars section on the home page: the old "Built to
 * mirror" pair and the "About CloudCertPrep" grid said the same things in the
 * same layout back to back, so they are merged and deduplicated here. Open
 * 2x2 grid of icon rows (one feature language page-wide), with the
 * free/open-source line + project link as the section footer.
 */
import { GITHUB_REPO_URL } from '../../lib/constants'

interface Props {
  heading?: string
}

const { heading = 'Built to mirror the real exam' } = Astro.props

// lucide icon path data (24x24, stroke-based)
const icons = {
  target: '<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>',
  bookCheck: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path><path d="m9 9.5 2 2 4-4"></path>',
  repeat: '<polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path>',
  barChart: '<line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line>',
}

const features = [
  {
    icon: icons.target,
    title: 'Realistic exam simulation',
    body: "Full-length, timed mock exams that mirror the live AWS exam: question style, scoring scale, duration, and passing score read from each cert's exam guide.",
  },
  {
    icon: icons.bookCheck,
    title: 'Every answer explained',
    body: 'Each question is aligned to the current official exam guide and ships with a detailed explanation of why the correct answer is right and why each distractor is wrong.',
  },
  {
    icon: icons.repeat,
    title: 'Adaptive spaced repetition',
    body: 'Domain practice prioritizes questions you have got wrong or have not seen, weighted by your past performance.',
  },
  {
    icon: icons.barChart,
    title: 'Domain mastery analytics',
    body: 'Track performance across every exam domain. Identify weak areas, focus practice where it matters most, and watch your scores climb over time.',
  },
]
---

<section>
  <p class="kicker" aria-hidden="true">The platform</p>
  <h2 class="font-display text-[1.75rem] md:text-[2.25rem] font-semibold tracking-[-0.02em] text-text-primary mb-10">{heading}</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
    {features.map((f, i) => (
      <div class="border-t border-border-hairline pt-5">
        <span class="font-mono text-[13px] font-semibold tracking-widest text-text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-2 text-lg md:text-xl font-semibold text-text-primary">{f.title}</h3>
        <p class="mt-2 text-base md:text-lg leading-[1.7] text-text-muted">{f.body}</p>
      </div>
    ))}
  </div>
  <p class="mt-8 flex flex-wrap items-center gap-x-2 text-base text-text-muted">
    <span>MIT licensed, no ads, no paywalls. Codebase on
      <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2 hover:text-link/80">GitHub</a>.</span>
    <a href="/about" class="chev-link font-medium text-link hover:underline underline-offset-4">Learn more about the project<span class="chev" aria-hidden="true">›</span></a>
  </p>
  <slot name="footer" />
</section>
