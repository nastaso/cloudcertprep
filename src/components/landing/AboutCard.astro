---
/**
 * AboutCard.astro — "About CloudCertPrep" card with a 4-icon list.
 * Astro port of the React AboutCard + DEFAULT_ABOUT_ITEMS with identical
 * Tailwind classes. Icons are inlined lucide SVG paths.
 */
import { GITHUB_REPO_URL } from '../../lib/constants'

interface Props {
  heading?: string
}

const { heading = 'About CloudCertPrep' } = Astro.props

// lucide icon path data (24x24, stroke-based)
const icons = {
  fileText: '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line>',
  repeat: '<polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path>',
  barChart: '<line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line>',
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>',
}
---

<section>
  <h2 class="text-xl md:text-2xl font-semibold text-text-primary mb-4">{heading}</h2>
  <div class="bg-bg-card rounded-xl p-4 md:p-6 shadow-card">
    <div class="space-y-3 md:space-y-4">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 md:w-6 md:h-6 text-text-muted flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.fileText} />
        <div>
          <p class="text-text-primary font-medium text-sm md:text-base">Realistic Exam Simulation</p>
          <p class="text-text-muted text-xs md:text-sm">Full-length, timed mock exams that mirror the real vendor format for each certification. Questions, duration, and passing score read from each cert's exam guide.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 md:w-6 md:h-6 text-text-muted flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.repeat} />
        <div>
          <p class="text-text-primary font-medium text-sm md:text-base">Adaptive Spaced Repetition</p>
          <p class="text-text-muted text-xs md:text-sm">Domain practice prioritises questions you have got wrong or have not seen, weighted by your past performance.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 md:w-6 md:h-6 text-text-muted flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.barChart} />
        <div>
          <p class="text-text-primary font-medium text-sm md:text-base">Domain Mastery Analytics</p>
          <p class="text-text-muted text-xs md:text-sm">Track performance across every exam domain. Identify weak areas, focus practice where it matters most, and watch your scores climb over time.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 md:w-6 md:h-6 text-text-muted flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.github} />
        <div>
          <p class="text-text-primary font-medium text-sm md:text-base">100% Free and Open Source</p>
          <p class="text-text-muted text-xs md:text-sm">
            MIT licensed. No ads, no paywalls, no premium tiers. Codebase on
            <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-text-primary/70 underline">GitHub</a>.
          </p>
        </div>
      </div>
    </div>
    <p class="mt-4 text-sm">
      <a href="/about" class="text-text-primary hover:text-text-primary/70 underline font-medium">Learn more about the project →</a>
    </p>
    <slot name="footer" />
  </div>
</section>
