---
/**
 * PrimaryExamCTA.astro — primary call to action that starts a
 * practice exam. A thin, semantic wrapper over the shared
 * `buttonClass({ variant: 'primary', size: 'lg' })` recipe from
 * `src/lib/buttonStyles.ts`, so it inherits the Apple-style pill shape, brand
 * fill, `focus-visible:ring-2 focus-visible:ring-brand` focus state, and the
 * `active:scale-[0.97]` press feedback. The `lg` size's padding
 * (`px-8 py-3 md:py-3.5 text-base md:text-lg`) yields a control taller than
 * 44px, meeting the touch-target rule.
 *
 * Production-liftable: depends only on the shared recipe and existing token
 * classes. Renders as a prerendered `<a>`.
 *
 * Usage:
 *   <PrimaryExamCTA href="/aws/clf-c02/practice-exam" label="Start CLF-C02 Practice Exam" />
 *
 * _Requirements: 4.2, 6.5, 6.6, 7.5, 8.1_
 */
import { buttonClass } from '../../lib/buttonStyles'

interface Props {
  href: string
  label: string
  class?: string
  [key: string]: unknown
}

const { href, label, class: className = '', ...rest } = Astro.props as Props

const cls = buttonClass({ variant: 'primary', size: 'lg', className })
---

<a class={cls} href={href} {...rest}>
  {label}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14" />
    <path d="m12 5 7 7-7 7" />
  </svg>
</a>
