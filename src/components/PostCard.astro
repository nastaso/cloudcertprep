---
/**
 * PostCard.astro — compact card for one blog post in the index listing.
 *
 * Links the title to /blog/<slug>, shows the publish date, description, and
 * tags. Takes the post entry's frontmatter `data` plus its `slug`.
 */
interface PostData {
  title: string
  description: string
  date: Date
  tags?: string[]
}

interface Props {
  data: PostData
  slug: string
}

const { data, slug } = Astro.props

const href = `/blog/${slug}`
const dateIso = data.date.toISOString()
const dateDisplay = data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

{/* DSv6: hairline card, mono date, quiet tag chips (brand colour is rare —
    orange tags violated the accent budget). Hover = border/surface only. */}
<article class="bg-bg-card border border-border-hairline rounded-2xl p-5 md:p-6 hover:border-text-muted/40 hover:bg-bg-card-hover transition-[border-color,background-color] duration-200">
  <p class="font-mono text-[12px] tracking-wide text-text-muted">
    <time datetime={dateIso}>{dateDisplay}</time>
  </p>
  <h2 class="mt-1.5 text-lg md:text-xl font-semibold tracking-[-0.01em] text-text-primary">
    <a href={href} class="hover:text-text-primary transition-colors rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-bg-card">{data.title}</a>
  </h2>
  <p class="mt-2 text-sm md:text-base text-text-muted leading-relaxed">{data.description}</p>
  {data.tags && data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2 list-none p-0 m-0">
      {data.tags.map((tag) => (
        <li class="font-mono text-[11px] px-2.5 py-1 rounded-full bg-bg-dark text-text-muted">#{tag}</li>
      ))}
    </ul>
  )}
</article>
