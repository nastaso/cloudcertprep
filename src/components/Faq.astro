---
/**
 * Faq.astro — prerendered FAQ section that mirrors the FAQPage JSON-LD.
 * Native <details>/<summary> (zero JS), emits FAQPage JSON-LD that matches
 * the visible entries.
 *
 * Two render modes:
 *
 *   1. Registry-driven (default). Reads FAQ_ENTRIES from seo-data.ts and
 *      groups by category. Used by /, the cert landings, etc.
 *      Props: { certCode?, genericOnly? }
 *
 *   2. Custom-entries. The caller passes a flat list of {question, answer};
 *      no grouping, no registry lookup. Used by per-domain pages whose FAQ
 *      content is page-specific. Props: { entries, headingId?, headingLabel? }
 *
 * Satisfies: R6.20, R6.10 (FAQPage JSON-LD parity).
 */
import { FAQ_ENTRIES, FAQ_CATEGORY_LABEL, FAQ_CATEGORY_ORDER } from '../lib/seo-data'
import { serializeJsonLd } from '../lib/jsonld'

interface SimpleEntry {
  question: string
  answer: string
}

interface Props {
  certCode?: string
  genericOnly?: boolean
  /** Custom entries override the registry. Flat (no category grouping). */
  entries?: SimpleEntry[]
  /** Heading id used by aria-labelledby (defaults to "faq-heading"). */
  headingId?: string
  /** Visible heading text (defaults to "Frequently asked questions"). */
  headingLabel?: string
}

const {
  certCode,
  genericOnly,
  entries: customEntries,
  headingId = 'faq-heading',
  headingLabel = 'Frequently asked questions',
} = Astro.props

const useCustom = !!customEntries

const registryEntries = useCustom
  ? []
  : genericOnly
    ? FAQ_ENTRIES.filter(e => !e.certCode)
    : certCode
      ? FAQ_ENTRIES.filter(e => !e.certCode || e.certCode === certCode)
      : FAQ_ENTRIES

const grouped = useCustom
  ? []
  : FAQ_CATEGORY_ORDER.map(category => ({
      category,
      entries: registryEntries.filter(e => e.category === category),
    })).filter(g => g.entries.length > 0)

const faqJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (useCustom ? customEntries! : registryEntries).map(entry => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.answer },
  })),
})

// Split bare URLs in an answer into linkable fragments.
function splitLinks(text: string): Array<{ text: string; isLink: boolean }> {
  return text.split(/(https?:\/\/[^\s)]+)/g).filter(Boolean).map(part => ({
    text: part,
    isLink: part.startsWith('http://') || part.startsWith('https://'),
  }))
}

const chevron = '<polyline points="6 9 12 15 18 9"></polyline>'
---

<section aria-labelledby={headingId} class="mt-8 md:mt-12">
  <script type="application/ld+json" set:html={faqJsonLd} />
  <h2 id={headingId} class="text-xl md:text-2xl font-semibold text-text-primary mb-4">
    {headingLabel}
  </h2>

  {useCustom ? (
    <div class="space-y-2">
      {customEntries!.map(entry => (
        <details class="group bg-bg-card rounded-xl shadow-card overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-4 md:px-6 py-3 md:py-4 cursor-pointer list-none text-text-primary font-medium text-sm md:text-base hover:bg-bg-card-hover transition-colors">
            <span>{entry.question}</span>
            <svg class="w-4 h-4 md:w-5 md:h-5 text-text-muted flex-shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={chevron} />
          </summary>
          <div class="px-4 md:px-6 pb-4 md:pb-5 text-text-muted text-sm md:text-base leading-relaxed">
            <p>{entry.answer}</p>
          </div>
        </details>
      ))}
    </div>
  ) : (
    <div class="space-y-6 md:space-y-8">
      {grouped.map(({ category, entries }) => (
        <div>
          <h3 class="text-base md:text-lg font-semibold text-text-primary mb-2 md:mb-3">
            {FAQ_CATEGORY_LABEL[category]}
          </h3>
          <div class="space-y-2">
            {entries.map(entry => (
              <details class="group bg-bg-card rounded-xl shadow-card overflow-hidden">
                <summary class="flex items-center justify-between gap-4 px-4 md:px-6 py-3 md:py-4 cursor-pointer list-none text-text-primary font-medium text-sm md:text-base hover:bg-bg-card-hover transition-colors">
                  <span>{entry.question}</span>
                  <svg class="w-4 h-4 md:w-5 md:h-5 text-text-muted flex-shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={chevron} />
                </summary>
                <div class="px-4 md:px-6 pb-4 md:pb-5 text-text-muted text-sm md:text-base leading-relaxed space-y-3">
                  {entry.steps ? (
                    <>
                      <p>{entry.steps.intro}</p>
                      <ol class="list-decimal list-outside pl-5 space-y-2 marker:text-text-muted">
                        {entry.steps.items.map(item => (
                          <li>
                            {splitLinks(item).map(frag => frag.isLink
                              ? <a href={frag.text} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-text-primary/70 underline break-all">{frag.text}</a>
                              : <span>{frag.text}</span>
                            )}
                          </li>
                        ))}
                      </ol>
                      {entry.steps.outro && <p>{entry.steps.outro}</p>}
                    </>
                  ) : (
                    <p>
                      {splitLinks(entry.answer).map(frag => frag.isLink
                        ? <a href={frag.text} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-text-primary/70 underline break-all">{frag.text}</a>
                        : <span>{frag.text}</span>
                      )}
                    </p>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}
</section>
