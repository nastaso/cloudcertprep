---
/**
 * GitHubPermalinkCallout.astro — links to the exact question-bank JSON file on
 * GitHub for a given (cert, domain), reinforcing the "publicly auditable"
 * open-source differentiator.
 *
 * Satisfies: R6.19.
 */
interface Props {
  certCode: string
  domainId: number
}

const { certCode, domainId } = Astro.props

const permalink = `https://github.com/nastaso/cloudcertprep/blob/main/src/data/${certCode}/domain${domainId}.json`

// lucide github icon path data (24x24, stroke-based)
const githubIcon = '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>'
---

<aside class="bg-bg-card rounded-xl border border-text-muted/20 p-4 md:p-5 text-sm text-text-muted flex items-start gap-3">
  <svg
    class="w-5 h-5 text-text-primary flex-shrink-0 mt-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={githubIcon}
  />
  <p class="leading-relaxed">
    Every question in this domain is{' '}
    <a
      href={permalink}
      target="_blank"
      rel="noopener noreferrer"
      class="text-text-primary hover:text-text-primary/70 underline font-medium"
    >publicly auditable on GitHub</a>. Inspect the source, suggest corrections, or open a pull request. The entire question bank is MIT licensed.
  </p>
</aside>
