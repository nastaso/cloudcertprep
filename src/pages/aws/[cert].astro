---
/**
 * /aws/:cert — the Cert_Landing.
 *
 * Dual-view by auth state, served from a single prerendered document:
 *   - The GUEST SEO landing (hero, CTA, bullets, AboutCard, FAQ) is prerendered
 *     as static Astro markup so crawlers and logged-out users always see it.
 *   - CertDashboardIsland (client:only="react") mounts after the guest view.
 *     For logged-in users it hides the static guest view and renders the
 *     authenticated dashboard (Practice Modes, Recent Attempts, Domain Mastery).
 *
 * getStaticPaths enumerates EVERY cert (active + coming-soon); coming-soon
 * certs render a landing with the ComingSoonBanner instead of the CTA+bullets.
 *
 * Satisfies: R6.1, R6.4, R6.10, R2.9, R10.6, R13.2.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Button from '../../components/Button.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import ComingSoonBanner from '../../components/ComingSoonBanner.astro'
import AboutCard from '../../components/landing/AboutCard.astro'
import ExamRealismTable from '../../components/ExamRealismTable.astro'
import ExplanationShowcase from '../../components/ExplanationShowcase.astro'
import Faq from '../../components/Faq.astro'
import LastUpdatedStamp from '../../components/LastUpdatedStamp.astro'
import CertDashboardIsland from '../../components/CertDashboardIsland.tsx'
import {
  CERTIFICATION_LIST,
  getActiveProviders,
  getCertDomainSlug,
  getCertTotalQuestions,
  getLevelLabel,
  getProviderLabel,
  isCertNoindex,
  type Certification,
} from '../../data/certifications'
import { SITE_URL } from '../../lib/seo-data'
import { serializeJsonLd } from '../../lib/jsonld'
import snapshot from '../../lib/generated/stats-snapshot.json'
import { getCollection, type CollectionEntry } from 'astro:content'
import PostCard from '../../components/PostCard.astro'

export function getStaticPaths() {
  // Enumerate all AWS certs (active + coming-soon). Coming-soon certs like
  // SAA-C03 still render a landing (with the ComingSoonBanner + GitHub watch
  // CTA). The `provider === 'aws'` filter scopes this `/aws/[cert]` route to
  // AWS certs only: a future non-AWS cert in the registry must NOT prerender at
  // `/aws/<code>` with a wrong provider label/canonical. (M8)
  return CERTIFICATION_LIST.filter(cert => cert.provider === 'aws').map(cert => ({
    params: { cert: cert.code },
    props: { cert },
  }))
}

interface Props {
  cert: Certification
}

const { cert } = Astro.props

const isActive = cert.status === 'active'
const isComingSoon = cert.status === 'coming-soon'

const examMinutes = Math.round(cert.examTimeSeconds / 60)
const providerLabel = getProviderLabel(cert.provider)
const certPath = `/${cert.provider}/${cert.code}`
const totalQuestions = getCertTotalQuestions(cert.code)
const totalQuestionsLabel = totalQuestions.toLocaleString('en-GB')
const levelLabel = getLevelLabel(cert.level)

// Per-cert SEO. Active certs get SERP-friendly specifics (question count,
// year); coming-soon certs avoid promising practice content they don't ship.
const title = isActive
  ? `Free ${cert.name} Practice Exam · ${totalQuestionsLabel}+ Questions · ${cert.shortName} 2026`
  : `${cert.name} (${cert.shortName}) Practice Exams · Coming Soon · CloudCertPrep`

const description = isActive
  ? `Free ${cert.name} (${cert.shortName}) practice exams. ${totalQuestionsLabel}+ practice questions across ${cert.domains.length} exam domains. ${cert.examQuestionCount}-question timed mock exam in ${examMinutes} minutes (pass at ${cert.passingScore}/1000). Open-source MIT-licensed alternative to paid AWS practice platforms. No signup, no ads. Updated for the 2026 exam guide.`
  : `${cert.name} (${cert.shortName}) practice exams are coming soon to CloudCertPrep. Watch the GitHub repository to be notified at launch.`

const canonical = `${SITE_URL}/aws/${cert.code}`

// Per-cert OG composite generated at build time by generate-og-images.mjs
// (resolves the prior AIF-C01-shares-CLF-OG mismatch). Falls back to the
// platform og-image.png only if generation fell back. (R6.14)
const ogImage = `${SITE_URL}/og/og-${cert.code}.png`

// Coming-soon certs render a real landing for the GitHub CTA but should not
// appear in search results; the same applies to any active cert still under
// review (CERTS_UNDER_REVIEW). Driven by the shared isCertNoindex helper so a
// future under-review cert auto-noindexes here. AIF-C01 ships GA + indexable
// (the set is empty at squash). (R2.9, R6.17)
const robots = isCertNoindex(cert) ? 'noindex' : 'index, follow'

// Breadcrumb items mirror the canonical navigation hierarchy. When there is
// only one active provider, the provider hub collapses to `/`, so the trail
// is Home → CertShortName.
const breadcrumbItems = getActiveProviders().length > 1
  ? [
      { label: 'Home', to: '/' },
      { label: providerLabel, to: `/${cert.provider}` },
      { label: cert.shortName },
    ]
  : [
      { label: 'Home', to: '/' },
      { label: cert.shortName },
    ]

// Build-time community enrollment for this cert (audit W15). Course rich
// results support totalHistoricalEnrollment; the /stats snapshot already holds
// attemptsCompleted per cert. Only emitted when there is real data (>0).
const certSnapshot = snapshot.certs.find(c => c.certCode === cert.code)
const enrollment = certSnapshot?.attemptsCompleted ?? 0
// Build date for the Course dateModified freshness signal (audit W21).
const buildDateIso = new Date().toISOString().slice(0, 10)

// Course JSON-LD for the certification.
const courseJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${cert.name} (${cert.shortName}) Practice Exam`,
  description: `Free practice exams and domain practice for the ${cert.name} (${cert.shortName}) certification. ${cert.examQuestionCount} questions in ${examMinutes} minutes, scored 100 to 1000.`,
  provider: { '@id': `${SITE_URL}/#organization` },
  url: `${SITE_URL}${certPath}`,
  inLanguage: 'en',
  isAccessibleForFree: true,
  educationalLevel: levelLabel,
  teaches: cert.domains.map(d => d.name).join(', '),
  dateModified: buildDateIso,
  ...(enrollment > 0 ? { totalHistoricalEnrollment: enrollment } : {}),
  about: {
    '@type': 'EducationalOccupationalCredential',
    name: cert.name,
    credentialCategory: 'certification',
    educationalLevel: levelLabel,
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    category: 'Free',
  },
})

// Serialise only the fields the dashboard island needs.
const certForIsland = {
  code: cert.code,
  name: cert.name,
  shortName: cert.shortName,
  provider: cert.provider,
  examQuestionCount: cert.examQuestionCount,
  examTimeSeconds: cert.examTimeSeconds,
  passingScore: cert.passingScore,
  domains: cert.domains.map(d => ({
    id: d.id,
    name: d.name,
    questionCount: d.questionCount,
  })),
}

// lucide check path data for hero bullets.
const checkIcon = '<polyline points="20 6 9 17 4 12"></polyline>'

const heroBullets = isComingSoon
  ? []
  : [
      `${cert.examQuestionCount} questions`,
      `${examMinutes} minutes`,
      `Pass at ${cert.passingScore}/1000`,
      '100% free',
    ]

// Cert-level secondary keyword (R13.2). The lowest-difficulty commercial-intent
// term for each active cert ("clf c02 practice exam" KD 2, vol 70; the parallel
// "aif c01 practice exam"). Rendered in the HYPHENATED brand form
// ("CLF-C02 practice exam") rather than the spaced Semrush string: search
// engines normalise hyphen<->space, so the hyphenated copy ranks for the
// spaced query while reading naturally (the verbatim "clf c02 ..." weave was
// awkward in a sentence/H2). BODY COPY ONLY — never the <title>/<meta>
// (R16.5). Coming-soon certs target nothing.
const CERT_SECONDARY_KEYWORD: Record<string, string> = {
  'clf-c02': 'CLF-C02 practice exam',
  'aif-c01': 'AIF-C01 practice exam',
}
const secondaryKeyword = isActive ? CERT_SECONDARY_KEYWORD[cert.code] : undefined

// Guest hero lede. When a secondary keyword exists, lead with it (mirroring the
// Domain_Landing's "Looking for {primaryKeyword}?" opener); otherwise keep the
// generic platform line.
const heroLede = secondaryKeyword
  ? `Looking for a free ${secondaryKeyword}? Practise realistic ${providerLabel} exam questions with adaptive domain mastery, randomised exams, and unlimited free attempts.`
  : `Practise realistic ${providerLabel} exam questions with adaptive domain mastery, randomised exams, and unlimited free attempts.`

// Per-domain landing links. These keyword-rich pages are the indexable SEO
// surface for each exam domain; linking them here creates the
// Home -> Cert -> Domain crawl path and makes them reachable by users.
// Active certs only (coming-soon certs have no published domain landings).
const domainLinks = isActive
  ? cert.domains.map(d => ({
      name: d.name,
      questionCount: d.questionCount,
      href: `/${cert.provider}/${cert.code}/${getCertDomainSlug(cert, d.id)}`,
    }))
  : []

// Latest blog posts for this cert (audit W13). Surfaces the blog on the
// highest-authority indexable page so posts get inbound internal links from
// the Cert_Landing, not just the Header island. Posts tagged with the cert
// code (e.g. 'clf-c02') come first; if none are tagged, fall back to the most
// recent non-draft posts so the block is never empty on an active cert.
const allPosts = isActive
  ? (await getCollection('blog'))
      .filter((post: CollectionEntry<'blog'>) => !post.data.draft)
      .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.date.getTime() - a.data.date.getTime())
  : []
const taggedPosts = allPosts.filter((post: CollectionEntry<'blog'>) => post.data.tags.includes(cert.code))
const latestPosts = (taggedPosts.length > 0 ? taggedPosts : allPosts).slice(0, 2)
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  robots={robots}
  jsonLd={[courseJsonLd]}
>
  <div class="p-4 md:p-8">
    <div class="max-w-4xl mx-auto">
      {/* BreadcrumbList JSON-LD only (visuallyHidden) */}
      <Breadcrumb items={breadcrumbItems} visuallyHidden />

      {/* Static GUEST view — visible to crawlers and logged-out users.
          CertDashboardIsland hides this for authenticated users. */}
      <div id="cert-guest-view" class="space-y-8">
        {/* Guest hero */}
        <div class="text-center py-4 md:py-8">
          <h1 class="text-3xl md:text-5xl font-bold text-text-primary mb-4 md:mb-6">
            Free {cert.name} <span class="whitespace-nowrap">({cert.shortName})</span>
            <span class="block text-text-primary mt-2">Practice Exams</span>
          </h1>
          <p class="text-lg md:text-xl text-text-muted mb-6 md:mb-8 max-w-2xl mx-auto">
            {heroLede}
          </p>

          {isComingSoon ? (
            <div class="mb-6 md:mb-8 text-left">
              <ComingSoonBanner cert={cert} />
            </div>
          ) : (
            <div class="flex justify-center mb-4 md:mb-6">
              <Button
                href={`${certPath}/practice-exam`}
                size="lg"
                arrow
                data-cc-event="cta_start_practice_exam"
                data-cc-param-location="cert_landing_hero"
                data-cc-param-cert={cert.code}
              >
                Start Practice Exam
              </Button>
            </div>
          )}

          {heroBullets.length > 0 && (
            <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-text-muted text-sm md:text-base mb-3 list-none p-0">
              {heroBullets.map(label => (
                <li class="inline-flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={checkIcon} />
                  {label}
                </li>
              ))}
            </ul>
          )}

          {isActive && (
            <div class="flex justify-center">
              <LastUpdatedStamp examGuideVersion={cert.examGuideVersion} examGuideUrl={cert.examGuideUrl} />
            </div>
          )}
        </div>

        {/* Guest About card (active certs only) */}
        {!isComingSoon && <AboutCard />}

        {/* Practice by exam domain — links to the per-domain keyword landing
            pages so they are reachable by users and crawlers (Home -> Cert ->
            Domain). Active certs only. */}
        {domainLinks.length > 0 && (
          <section>
            <h2 class="text-xl md:text-2xl font-semibold text-text-primary mb-4">
              {secondaryKeyword ? `Build your ${secondaryKeyword} by domain` : 'Practice by exam domain'}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {domainLinks.map(d => (
                <a
                  href={d.href}
                  class="block bg-bg-card hover:bg-bg-card-hover rounded-xl shadow-card p-4 transition-colors border-2 border-transparent hover:border-brand lift focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-bg-dark"
                >
                  <span class="block text-text-primary font-medium text-sm md:text-base">{d.name}</span>
                  <span class="block text-text-muted text-xs md:text-sm mt-1">{d.questionCount}+ practice questions</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* Exam realism + explanation showcase (active certs with a verified
            examFormat / question bank; both self-guard and render nothing
            otherwise). Mounted after the hero block, before the FAQ. (R23.1, R23.2) */}
        <ExamRealismTable cert={cert} />
        <ExplanationShowcase cert={cert} />

        {/* Latest from the blog (audit W13) — internal links from the
            highest-authority indexable page to the blog. Only rendered when a
            post exists. */}
        {latestPosts.length > 0 && (
          <section>
            <h2 class="text-xl md:text-2xl font-semibold text-text-primary mb-4">Latest from the blog</h2>
            <div class="grid grid-cols-1 gap-4">
              {latestPosts.map((post: CollectionEntry<'blog'>) => (
                <PostCard data={post.data} slug={post.data.slug} />
              ))}
            </div>
            <p class="mt-4 text-sm">
              <a href="/blog" class="text-text-primary hover:text-text-primary/70 underline font-medium">Read all articles →</a>
            </p>
          </section>
        )}

        {/* Per-cert FAQ + FAQPage JSON-LD */}
        <Faq certCode={cert.code} />
      </div>
    </div>

    {/* Authenticated dashboard island. Renders null + keeps guest view
        visible for logged-out users; hides guest view + shows dashboard
        for logged-in users. */}
    <CertDashboardIsland cert={certForIsland} client:only="react" />
  </div>

  {/*
    Synchronous guest-view pre-hide. Runs before paint (and on bfcache
    restore via pageshow) so a logged-in user never sees the prerendered
    guest landing flash before CertDashboardIsland hydrates. Reuses the
    `window.__ccHasSession` helper installed by the BaseLayout pre-paint
    script (single source of truth for the localStorage scan). Stale tokens
    self-correct once the island resolves auth and re-shows the guest view.
    Only meaningful on this cert landing (the only page with #cert-guest-view).
  */}
  <script is:inline>
    (function () {
      function apply() {
        var el = document.getElementById('cert-guest-view')
        if (el && window.__ccHasSession && window.__ccHasSession()) el.style.display = 'none'
      }
      apply()
      window.addEventListener('pageshow', apply)
    })()
  </script>
</BaseLayout>
