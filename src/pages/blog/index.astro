---
/**
 * Blog index (/blog) — post listing.
 *
 * Lists non-draft posts (in PROD), sorted by date descending. Because the
 * route is a single static page (index.astro has no [page] param segment to
 * spread paginate() URLs into), the listing renders up to PAGE_SIZE most
 * recent posts; when the catalogue grows past PAGE_SIZE a dedicated
 * `blog/page/[page].astro` route can take over numbered pages. The canonical
 * is self-referential and RSS autodiscovery is emitted via BaseLayout's named
 * `head` slot.
 */
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import HeroMini from '../../components/landing/HeroMini.astro'
import PostCard from '../../components/PostCard.astro'
import { SITE_URL } from '../../lib/seo-data'

const PAGE_SIZE = 10

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) =>
  import.meta.env.PROD ? data.draft !== true : true,
)
const sorted = posts
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, PAGE_SIZE)

const canonical = `${SITE_URL}/blog`

const breadcrumbItems = [{ label: 'Home', to: '/' }, { label: 'Blog' }]

const description =
  'AWS certification study guides, exam-format breakdowns, and prep strategy for the Cloud Practitioner and AI Practitioner exams, from the CloudCertPrep team.'
---

<BaseLayout title="AWS Certification Study Guides · CloudCertPrep Blog" description={description} canonical={canonical} ogImage={`${SITE_URL}/og/og-blog.png`} headerOverlay={true}>
  <Breadcrumb items={breadcrumbItems} visuallyHidden />

  <HeroMini
    kicker="Blog"
    title="CloudCertPrep Blog"
    lede={description}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    maxWidth="max-w-3xl"
  />

  <div class="sheet-overlap pb-16 md:pb-24 pt-10 md:pt-14">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      {sorted.length === 0 ? (
        <p class="text-text-muted">No posts yet. Check back soon.</p>
      ) : (
        <div class="space-y-5">
          {sorted.map((post: CollectionEntry<'blog'>) => (
            <PostCard data={post.data} slug={post.data.slug} />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
