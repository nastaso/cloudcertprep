---
/**
 * /reset-password — interactive page body island. Noindexed (R2.7).
 * Static Astro chrome comes from BaseLayout; AppIsland renders only the body.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import AppIsland from '../components/AppIsland.tsx'
---

<BaseLayout
  title="Reset Password · CloudCertPrep"
  description="Reset your CloudCertPrep account password."
  canonical="https://www.cloudcertprep.io/reset-password"
  robots="noindex"
  noscriptDirectory={true}
>
  <AppIsland client:only="react" />
</BaseLayout>
