/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cloud.umami.is https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.google-analytics.com https://cloud.umami.is https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# CSP NOTE: the `'unsafe-inline'` token in script-src above is a BUILD-TIME
# PLACEHOLDER. The postbuild step `scripts/generate-csp-hashes.mjs` rewrites the
# dist/_headers copy of this CSP, replacing `'unsafe-inline'` with the exhaustive
# set of `'sha256-...'` hashes of every inline <script> in dist/**/*.html. The
# host-source allowlists (googletagmanager / umami / cloudflare) stay so the
# dynamically-injected GA loader, Umami, and Turnstile scripts keep loading.
# Edit inline scripts freely; the hashes regenerate on every build. (security V2/V13)

# Static assets have content-hashed filenames (e.g. index-A8f2k3.js), so they
# are safe to cache forever. New deploys produce new hashes => new filenames.
# NOTE: no `/*` Cache-Control rule is set. Netlify MERGES every matching rule's
# headers rather than letting a more specific path override, so a `/*`
# `max-age=0` would combine with this immutable rule and defeat long-term
# caching of hashed assets. HTML routes fall back to Netlify's default
# (revalidated) caching, which is correct for one-HTML-file-per-route output.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
