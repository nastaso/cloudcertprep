# Supabase (required for auth and progress saving)
# Get these from your Supabase project at https://supabase.com/dashboard
# Public-by-design: the anon key is enforced by Row Level Security on the server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics 4 (optional, production only).
# Currently DORMANT: GA is disabled and the cookie-consent banner is hidden
# (CookieConsentIsland is unmounted in BaseLayout.astro), so GA never loads even
# if this is set. Active analytics is cookieless Umami only. To re-enable:
# (1) set this var, (2) re-mount the consent banner (CookieConsentIsland in
# BaseLayout.astro), and (3) re-add googletagmanager (script-src) +
# google-analytics (connect-src) to the CSP in public/_headers.
VITE_GA_MEASUREMENT_ID=

# Umami Analytics (optional, production only). Cookieless, GDPR-friendly,
# always-on. Find the website ID in your Umami cloud dashboard.
# Leave blank for local development; the Umami script is skipped entirely.
VITE_UMAMI_WEBSITE_ID=

# Cloudflare Turnstile (bot protection on the auth flow).
# The SITE key is public-by-design and ships in client code. The SECRET key is
# NOT used by the app — it is pasted into the Supabase Dashboard
# (Authentication -> Settings -> Bot and Abuse Protection) where Supabase
# validates the token server-side. Never put the secret in this file or in env.
# Get the keys at https://dash.cloudflare.com -> Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Sentry (optional, production error monitoring).
# Get your DSN from https://sentry.io after creating a project.
# Requires the @sentry/react package and Sentry initialization in a client
# entrypoint; src/lib/logger.ts then forwards errors to window.Sentry.
# Leave blank to disable Sentry.
VITE_SENTRY_DSN=
